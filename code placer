<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Contact | Print & Eat</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

  <style>
   
    /* ========= CONTACT SECTION ========= */

    .contact-hero {
      text-align: center;
      padding: 60px 20px 20px;
    }

    .contact-hero h1 {
      font-size: 32px;
      font-weight: 700;
      color: #0066cc;
    }

    .contact-hero p {
      font-size: 18px;
      margin-top: 10px;
      color: #444;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      max-width: 1200px;
      margin: 40px auto;
      padding: 20px;
    }

    .contact-card {
      background: linear-gradient(to right, #e6f4ff, #ffffff);
      border: 2px solid #cce5ff;
      border-radius: 16px;
      padding: 30px;
      text-align: center;
      box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .contact-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.12);
    }

    .contact-card h2 {
      font-size: 22px;
      margin-bottom: 10px;
      color: #003d99;
    }

    .contact-info {
      font-size: 16px;
      margin: 15px 0;
      line-height: 1.6;
    }

    .contact-btn {
      display: inline-block;
      background-color: #0072ff;
      color: #fff;
      padding: 12px 22px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: background 0.3s;
    }

    .contact-btn:hover {
      background-color: #005ed6;
    }

    .contact-btn.small {
      padding: 10px 16px;
      font-size: 14px;
      margin: 5px;
    }

    .btn-group {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .info-bottom {
      text-align: center;
      margin: 30px;
      font-size: 16px;
      color: #555;
    }

    @media (max-width: 768px) {
      .contact-hero h1 {
        font-size: 26px;
      }

      .contact-card {
        padding: 20px;
      }

      .contact-btn {
        width: 100%;
        margin-bottom: 10px;
      }

      .btn-group {
        flex-direction: column;
        align-items: center;
      }
    }

    
/* ======================== */
/*        DROPDOWN          */
/* ======================== */

.dropdown {
  position: relative;
  display: inline-block;
}

.dropbtn {
  color: white;
  font-size: 16px;
  border: none;
  background-color: inherit;
  padding: 10px;
  cursor: pointer;
  transition: color 0.3s;
}

.dropbtn:hover {
  color: #0052a3;
}

.dropdown-content {
  display: none;
  position: absolute;
  background-color: #005bb8;
  min-width: 160px;
  z-index: 1;
}

.dropdown-content a {
  color: white;
  padding: 10px;
  text-decoration: none;
  display: block;
}

.dropdown-content a:hover {
  background-color: #0052a3;
}

.dropdown:hover .dropdown-content {
  display: block;
}

/* Hover colors by category */
.dropdown-content a[href="print.html"]:hover {
  color: #66b2ff;
}

.dropdown-content a[href="cafe.html"]:hover {
  color: #ffcc00;
}

.dropdown-content a[href="alu.html"]:hover {
  color: #cccccc;
}

/* ======================== */
/*        HEADER LOGO       */
/* ======================== */

.header-logo {
  position: absolute;
  bottom: 12px;
  left: 150px;
  font-family: 'Poppins', sans-serif;
  font-size: 26px;
  font-weight: 600;
  color: #ffffff;
  text-decoration: none;
  letter-spacing: 1px;
  transition: color 0.3s ease;
  z-index: 10;
}

.logo:hover {
  color: #ffcc00;
}

/* ======================== */
/*     RESPONSIVE MOBILE    */
/* ======================== */

@media (max-width: 768px) {
  nav {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
  }

  ul.nav-links {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: auto;
    margin-top: 10px;
  }

  ul.nav-links li {
    padding: 10px;
  }

  ul.nav-links li a {
    font-size: 14px;
  }

  .dropdown-content {
    position: absolute;
    background-color: #005bb8;
    min-width: 120px;
    top: 100%;
    left: 0;
    z-index: 1;
  }

  .dropbtn {
    padding: 10px;
  }

  .header-logo {
    position: static;
    font-size: 20px;
    margin-bottom: 0;
    left: 16px;
    bottom: 10px;
  } }

  
  </style>
</head>
<body>

  <header>
